<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title><%= page_title %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400..700;1,400..700&family=Manrope:wght@400..800&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "application" %>
  <%= yield :head %>
  <script src="/sondage/ui.js" defer></script>
</head>
<body class="<%= content_for(:body_class) %> <%= "fellow-ui" if user_signed_in? && current_user.fellow? %>">
  <header class="masthead">
    <%= link_to root_path, class: "brand" do %><span class="wordmark">Sondage</span><span class="sub">• standard</span><% end %>
    <% if user_signed_in? %>
      <nav>
        <%= nav_link "Home", root_path %>
        <% if current_user.admin? %><%= nav_link "Intake questions", intake_questions_path %><% end %>
        <% if current_user.fellow? && current_user.fellow %><%= nav_link "My timeline", fellow_timeline_path(current_user.fellow) %><%= nav_link "My journal", fellow_journal_entries_path(current_user.fellow) %><%= nav_link (current_user.fellow.historian ? "My historian" : "Choose a historian"), match_path %><% end %>
        <% if current_user.admin? %><%= nav_link "Matching", match_path %><% end %>
        <% if current_user.historian? %><%= nav_link "Find Fellows", match_path %><%= nav_link "My profile", edit_historian_profile_path %><% end %>
        <span class="who"><%= current_user.name %> · <%= current_user.role.capitalize %></span>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "link" %>
      </nav>
    <% end %>
  </header>
  <main>
    <% if notice %><p class="flash notice"><%= notice %></p><% end %>
    <% if alert %><p class="flash alert"><%= alert %></p><% end %>
    <%= yield %>
  </main>
  <footer class="colophon">
    <p class="colophon-line">every life is a history.</p>
    <p>Human-made. No AI is used to collect, record, transcribe or interpret anything here.</p>
  </footer>
</body>
</html>
