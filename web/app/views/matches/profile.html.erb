<% page_title "Your profile" %>
<p class="eyebrow">Historian</p>
<h1>Your profile</h1>
<p class="lede">This is what Fellows read when they choose a historian. Write plainly and warmly; many Fellows are in their 80s and 90s.</p>
<article class="card narrow-card">
  <%= form_with model: @profile, url: match_profile_path, method: :patch, class: "stack" do |f| %>
    <div class="field"><%= f.label :headline, "One line about you" %><%= f.text_field :headline, placeholder: "Oral historian of Puerto Rican New York" %></div>
    <div class="field"><%= f.label :bio, "About you" %><%= f.text_area :bio, rows: 8 %><p class="hint small">Where you're from, why you do this work, and how you like to listen.</p></div>
    <div class="row">
      <div class="field"><%= f.label :languages %><%= f.text_field :languages, placeholder: "English, Spanish" %></div>
      <div class="field"><%= f.label :regions, "Places you know well" %><%= f.text_field :regions, placeholder: "New York, Puerto Rico" %></div>
    </div>
    <div class="field"><%= f.label :specialties, "Subjects you're drawn to" %><%= f.text_field :specialties, placeholder: "Migration, small business, music" %></div>
    <label class="choices"><span><%= f.check_box :accepting %> I'm taking new Fellows</span></label>
    <div class="actions"><%= f.submit "Save my profile", class: "primary" %><%= link_to "Back to Find Fellows", match_path, class: "link" %></div>
  <% end %>
</article>
