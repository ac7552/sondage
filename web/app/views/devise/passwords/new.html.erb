<% page_title "Forgot your password?" %>
<span class="wordmark">Sondage</span>
<h1 style="font-size:34px;margin-top:16px">Forgot your password?</h1>
<p>Type your email and we'll send you a link to choose a new one. The link works for 24 hours.</p>
<%= error_summary(resource) %>
<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "stack card" }) do |f| %>
  <div class="field"><%= f.label :email %><%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %></div>
  <%= f.submit "Email me a link", class: "primary" %>
<% end %>
<p><%= link_to "Back to sign in", new_session_path(resource_name) %></p>
