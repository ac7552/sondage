<% page_title "Fellows" %>
<p class="eyebrow">Admin</p>
<h1>Fellows</h1>
<div class="actions"><%= link_to "Add a Senior Fellow", new_admin_fellow_path, class: "button primary" %><% if feature?(:intake) %><%= link_to "Edit intake questions", intake_questions_path, class: "button quiet" %><% end %><% if feature?(:matching) %><% n = MatchInterest.mutual.count %><%= link_to (n > 0 ? "Matching (#{n} to confirm)" : "Matching"), match_path, class: "button quiet" %><% end %></div>

<table class="list" style="margin-top: 28px">
  <thead><tr><th>Senior Fellow</th><th><%= feature?(:stages) ? "Stage" : "Season" %></th><th>Next Sitting</th><th></th></tr></thead>
  <tbody>
    <% @fellows.each do |f| %>
      <% nxt = f.meetings.select { |m| m.status.in?(%w[scheduled in_progress]) }.min_by { |m| m.scheduled_at || Time.current } %>
      <tr>
        <td><%= link_to f.display_name, fellow_path(f) %><div class="small muted"><%= [f.birth_year, f.birth_place].compact.join(" · ") %></div></td>
        <td><% if feature?(:stages) %><span class="tag <%= 'good' if f.stage == 'delivered' %>"><%= f.stage_label %></span><% else %><span class="mono small"><%= f.season_key || "not set" %></span><% end %></td>
        <td class="small"><%= nxt ? "#{nxt.title.split(' with ').first} · #{nxt.scheduled_at&.strftime('%b %-d, %-l:%M %p') || 'unscheduled'}" : "—" %></td>
        <td class="small"><%= link_to "Timeline", fellow_timeline_path(f) if feature?(:timeline) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<% if @fellows.empty? %><p class="muted">No Fellows yet.</p><% end %>
