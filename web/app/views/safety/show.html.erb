<% page_title "Safety copy" %>
<span class="wordmark">Sondage</span>
<p class="eyebrow">Safety copy</p>
<div id="safety" data-age-js="/sondage/vendor/age.js">
  <h1 id="s-title" style="font-size:34px">One moment…</h1>
  <div id="s-body"><p class="muted">Checking your safety copy.</p></div>
  <div class="actions" id="s-actions" hidden>
    <button class="primary" id="s-yes"></button>
    <button id="s-no"></button>
  </div>
  <p class="small muted" id="s-foot" style="margin-top:28px">Your safety copy stays in your email. Sondage never sees it. When you click Yes, it is locked so only the new computer can use it.</p>
</div>
<%= sondage_script_tag "safety.js", fallback: false %>
